<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Background Canvas -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#0A101D" />
                <item android:offset="1.0" android:color="#030508" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer Glowing Square Accent -->
    <path
        android:pathData="M28,24 h52 a10,10 0 0 1 10,10 v52 a10,10 0 0 1 -10,10 h-52 a10,10 0 0 1 -10,-10 v-52 a10,10 0 0 1 10,-10 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="24"
                android:startY="20"
                android:endX="84"
                android:endY="92"
                android:type="linear">
                <item android:offset="0.0" android:color="#3300F0FF" />
                <item android:offset="1.0" android:color="#22FF9900" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Square Terminal Window -->
    <path
        android:pathData="M30,26 h48 a8,8 0 0 1 8,8 v48 a8,8 0 0 1 -8,8 h-48 a8,8 0 0 1 -8,-8 v-48 a8,8 0 0 1 8,-8 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"
                android:startY="26"
                android:endX="78"
                android:endY="82"
                android:type="linear">
                <item android:offset="0.0" android:color="#0F1B2B" />
                <item android:offset="1.0" android:color="#060A10" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Window Cyber Border -->
    <path
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M30,26 h48 a8,8 0 0 1 8,8 v48 a8,8 0 0 1 -8,8 h-48 a8,8 0 0 1 -8,-8 v-48 a8,8 0 0 1 8,-8 z">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="22"
                android:startY="26"
                android:endX="86"
                android:endY="82"
                android:type="linear">
                <item android:offset="0.0" android:color="#00F0FF" />
                <item android:offset="0.6" android:color="#0088FF" />
                <item android:offset="1.0" android:color="#FF9900" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Header Divider -->
    <path
        android:strokeColor="#1E334D"
        android:strokeWidth="1.2"
        android:pathData="M22,38 L86,38" />

    <!-- 3 Terminal Header Dots -->
    <path
        android:pathData="M30,32m-2.2,0a2.2,2.2 0 1,1 4.4,0a2.2,2.2 0 1,1 -4.4,0"
        android:fillColor="#FF5555" />
    <path
        android:pathData="M36.5,32m-2.2,0a2.2,2.2 0 1,1 4.4,0a2.2,2.2 0 1,1 -4.4,0"
        android:fillColor="#FFB800" />
    <path
        android:pathData="M43,32m-2.2,0a2.2,2.2 0 1,1 4.4,0a2.2,2.2 0 1,1 -4.4,0"
        android:fillColor="#00F0FF" />

    <!-- Terminal '>' Prompt -->
    <path
        android:strokeColor="#00F0FF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M37,49 L47,57 L37,65" />

    <!-- Terminal '_' Cursor -->
    <path
        android:strokeColor="#FF9900"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M52,65 L66,65" />
</vector>

