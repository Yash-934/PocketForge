<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Centered Cyber Forge Outer Shield / Anvil Frame -->
    <!-- Safe zone is centered around 54, 54 with ~66dp diameter -->
    <group android:pivotX="54" android:pivotY="54">
        <!-- Outer Glowing Accent Shield -->
        <path
            android:strokeColor="#00F0FF"
            android:strokeWidth="2.5"
            android:strokeLineJoin="round"
            android:strokeLineCap="round"
            android:fillColor="#1500F0FF"
            android:pathData="M32,32 L76,32 L84,46 L76,64 L54,82 L32,64 L24,46 Z" />

        <!-- Futuristic Anvil Top Bar (Cyber Forge Horns) -->
        <path
            android:pathData="M27,35 L81,35 L76,43 L32,43 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="27"
                    android:startY="35"
                    android:endX="81"
                    android:endY="43"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#00F0FF" />
                    <item android:offset="0.5" android:color="#00B8FF" />
                    <item android:offset="1.0" android:color="#FF9900" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Anvil Core Body -->
        <path
            android:pathData="M36,46 L72,46 L65,65 L54,74 L43,65 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="54"
                    android:startY="46"
                    android:endX="54"
                    android:endY="74"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#0E1A2C" />
                    <item android:offset="1.0" android:color="#050C16" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Inner Terminal Code Prompt '> _' Glowing in Neon Cyan & Amber -->
        <!-- '>' Arrow Prompt -->
        <path
            android:strokeColor="#00F0FF"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000"
            android:pathData="M45,52 L52,58 L45,64" />

        <!-- '_' Terminal Cursor Prompt -->
        <path
            android:strokeColor="#FF9900"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M56,64 L64,64" />

        <!-- Spark / Energy Particles -->
        <path
            android:pathData="M54,26 L55.5,29.5 L59,31 L55.5,32.5 L54,36 L52.5,32.5 L49,31 L52.5,29.5 Z"
            android:fillColor="#00F0FF" />

        <!-- Side Cyber Energy Nodes -->
        <path
            android:pathData="M23,46m-2,0a2,2 0 1,1 4,0a2,2 0 1,1 -4,0"
            android:fillColor="#00F0FF" />
            
        <path
            android:pathData="M85,46m-2,0a2,2 0 1,1 4,0a2,2 0 1,1 -4,0"
            android:fillColor="#FF9900" />
    </group>
</vector>
